# Copy to `backend/.env` and uncomment what you want to override.
# API keys for Claude/Gemini are NOT set here — save them from the dashboard (Agent connectors);
# they go into your OS credential vault (Windows Credential Manager / macOS Keychain).

# ---------- AI models ----------
# APPLY_COPILOT_CLAUDE_DEFAULT_MODEL=claude-opus-5-5
# APPLY_COPILOT_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# APPLY_COPILOT_OLLAMA_BASE_URL=http://localhost:11434
# APPLY_COPILOT_OLLAMA_DEFAULT_MODEL=llama3.1
# APPLY_COPILOT_LLM_TIMEOUT_SECONDS=240
# APPLY_COPILOT_OLLAMA_TIMEOUT_SECONDS=600

# ---------- App ----------
# APPLY_COPILOT_DATABASE_URL=sqlite:///./data/apply_copilot.db
# APPLY_COPILOT_CORS_ALLOWED_ORIGINS=["http://localhost:5174"]
# APPLY_COPILOT_MAX_RESUME_BYTES=5242880
